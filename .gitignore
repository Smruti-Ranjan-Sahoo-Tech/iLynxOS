jspm_packages/
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python Bytecode, Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Large Archives, Rootfs Images & Compression Formats
*.tar.gz
*.tar.xz
*.tar.bz2
*.tar
*.gz
*.zip
*.7z
*.rar
*.iso
*.img
*.qcow2
*.vmdk
*.raw

# Specific OS Rootfs Tarballs
iLynxOS-*.tar.gz

# Gradle Build System & Cache
.gradle/
build/
*/build/
app/build/

# Android Studio & JetBrains IDE Files
.idea/
*.iml
*.iws
*.ipr
out/
captures/
.externalNativeBuild/
.cxx/

# VS Code & Other Editor Artifacts
.vscode/
*.sublime-project
*.sublime-workspace
.settings/
.project
.classpath

# Local Configuration, Passwords & Keystores
local.properties
*.keystore
*.jks
google-services.json

# Operating System Temp & Cache Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
de

# Logs, Dumps & Temp Files
*.log
*.tmp
*.bak
*.swp
*~
tmp/
core
*.pid

# Promotional & Marketing Assets
social/

